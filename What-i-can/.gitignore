# What-i-can/ — gitignore

# Generated artifacts (don't commit)
test-results/
backups/
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
logs/

# Build
dist/
build/

# Test coverage
coverage/
.nyc_output/

# Editor temp files
*~
*.tmp
*.bak

# Sensitive — never commit secrets
*.env
*.env.*
!.env.example

# Word doc (if user generates PDF locally)
*.docx

# Don't ignore the path-test marker (until we clean it up)
# !.path-test
